#!/usr/bin/env node

const childProcess = require("child_process")
const fs = require("fs")
const path = require("path")
const os = require("os")

const INTERACTIVE_SWITCH = "__INTERACTIVE_SWITCH__"
const DEFAULT_FAMILY = "gemini"
const RESTART_DELAY_MS = 600
const PYTHON_CANDIDATES = process.platform === "win32"
  ? [
      process.env.OPENCODE_AUTH_PYTHON || "",
      path.join(os.homedir(), "AppData", "Local", "Programs", "Python", "Python313", "python.exe"),
      path.join(os.homedir(), "AppData", "Local", "Programs", "Python", "Python312", "python.exe"),
      "py",
      "python",
      "python3",
    ]
  : [
      process.env.OPENCODE_AUTH_PYTHON || "",
      "python3",
      "python",
    ]

let cachedPythonLauncher

function isAuthRoot(value) {
  return value === "auth" || value === "providers"
}

function isAuthListCommand(args) {
  return args.length >= 2 && isAuthRoot(args[0]) && (args[1] === "list" || args[1] === "ls")
}

function isAuthSaveCommand(args) {
  return args.length >= 2 && isAuthRoot(args[0]) && args[1] === "save"
}

function isAuthSwitchCommand(args) {
  return args.length >= 2 && isAuthRoot(args[0]) && args[1] === "switch"
}

function isAuthProfilesCommand(args) {
  return args.length >= 2 && isAuthRoot(args[0]) && args[1] === "profiles"
}

function isAuthCurrentCommand(args) {
  return args.length >= 2 && isAuthRoot(args[0]) && ["current", "status", "whoami"].includes(args[1])
}

function isAuthDoctorCommand(args) {
  return args.length >= 2 && isAuthRoot(args[0]) && args[1] === "doctor"
}

function isAuthRepairCommand(args) {
  return args.length >= 2 && isAuthRoot(args[0]) && args[1] === "repair"
}

function isAuthRenameCommand(args) {
  return args.length >= 2 && isAuthRoot(args[0]) && args[1] === "rename"
}

function isAuthDeleteCommand(args) {
  return args.length >= 2 && isAuthRoot(args[0]) && ["delete", "remove", "rm"].includes(args[1])
}

function isAuthCloneCommand(args) {
  return args.length >= 2 && isAuthRoot(args[0]) && args[1] === "clone"
}

function isAuthRootHelpRequest(args) {
  return isAuthRoot(args[0]) && (args.length === 1 || (args.length === 2 && ["-h", "--help"].includes(args[1])))
}

function getOpencodeHome() {
  return path.join(os.homedir(), ".local", "share", "opencode")
}

function getAuthPath() {
  return path.join(getOpencodeHome(), "auth.json")
}

function getProfilesPath() {
  return path.join(getOpencodeHome(), "auth.profiles.json")
}

function getAntigravityAccountsPath() {
  return path.join(os.homedir(), ".config", "opencode", "antigravity-accounts.json")
}

function getAntigravityConfigPath() {
  return path.join(os.homedir(), ".config", "opencode", "antigravity.json")
}

function getOpencodeDbPath() {
  return path.join(getOpencodeHome(), "opencode.db")
}

function getPythonLaunchers() {
  const unique = []
  for (const candidate of PYTHON_CANDIDATES) {
    if (!candidate) continue
    if (!unique.includes(candidate)) unique.push(candidate)
  }
  return unique.map((candidate) => {
    if (candidate === "py") {
      return {
        command: candidate,
        args: ["-3"],
      }
    }
    return {
      command: candidate,
      args: [],
    }
  })
}

function canRunPythonLauncher(launcher) {
  if (launcher.command.includes(path.sep) && !fs.existsSync(launcher.command)) {
    return false
  }
  const result = childProcess.spawnSync(launcher.command, [...launcher.args, "-c", "import sqlite3"], {
    encoding: "utf8",
    windowsHide: true,
  })
  return !result.error && result.status === 0
}

function getAvailablePythonLauncher() {
  if (typeof cachedPythonLauncher !== "undefined") {
    return cachedPythonLauncher
  }
  for (const launcher of getPythonLaunchers()) {
    if (canRunPythonLauncher(launcher)) {
      cachedPythonLauncher = launcher
      return cachedPythonLauncher
    }
  }
  cachedPythonLauncher = null
  return cachedPythonLauncher
}

function parseFlagValue(args, index, name) {
  const value = args[index + 1]
  if (!value || value.startsWith("-")) {
    console.error(`Missing value for ${name}`)
    process.exit(1)
  }
  return value
}

function parseNamedValueArg(args, index, name) {
  const arg = args[index]
  if (arg === name) {
    return {
      value: parseFlagValue(args, index, name),
      consumed: 2,
    }
  }
  if (arg.startsWith(`${name}=`)) {
    return {
      value: arg.slice(name.length + 1),
      consumed: 1,
    }
  }
  return null
}

function normalizeSwitchValue(value) {
  if (!value || value === "interactive") return INTERACTIVE_SWITCH
  return value
}

function normalizeFamily(value) {
  if (!value) return DEFAULT_FAMILY
  const normalized = String(value).trim().toLowerCase()
  if (!["gemini", "claude"].includes(normalized)) {
    console.error(`Unsupported family: ${value}`)
    process.exit(1)
  }
  return normalized
}

function ensureDirectory(dirPath) {
  fs.mkdirSync(dirPath, { recursive: true })
}

function deepClone(value) {
  return JSON.parse(JSON.stringify(value))
}

function readJsonFile(filePath, fallback) {
  if (!fs.existsSync(filePath)) {
    if (typeof fallback !== "undefined") return deepClone(fallback)
    console.error(`File not found: ${filePath}`)
    process.exit(1)
  }

  try {
    return JSON.parse(fs.readFileSync(filePath, "utf8"))
  } catch (error) {
    console.error(`Failed to parse JSON file: ${filePath}`)
    console.error(error instanceof Error ? error.message : String(error))
    process.exit(1)
  }
}

function writeJsonFile(filePath, value) {
  ensureDirectory(path.dirname(filePath))
  const tempPath = `${filePath}.tmp-${process.pid}-${Date.now()}`
  fs.writeFileSync(tempPath, `${JSON.stringify(value, null, 2)}\n`, "utf8")
  fs.rmSync(filePath, { force: true })
  fs.renameSync(tempPath, filePath)
}

function getAuthData() {
  const authPath = getAuthPath()
  if (!fs.existsSync(authPath)) {
    console.error(`Credentials file not found: ${authPath}`)
    process.exit(1)
  }
  return readJsonFile(authPath)
}

function writeAuthData(value) {
  writeJsonFile(getAuthPath(), value)
}

function getEmptyProfilesStore() {
  return {
    activeProfile: null,
    profiles: {},
  }
}

function getProfilesStore() {
  const store = readJsonFile(getProfilesPath(), getEmptyProfilesStore())
  if (!store || typeof store !== "object") return getEmptyProfilesStore()
  if (!store.profiles || typeof store.profiles !== "object") {
    store.profiles = {}
  }
  if (!Object.prototype.hasOwnProperty.call(store, "activeProfile")) {
    store.activeProfile = null
  }
  return store
}

function writeProfilesStore(store) {
  writeJsonFile(getProfilesPath(), store)
}

function getAntigravityAccountsStore() {
  const filePath = getAntigravityAccountsPath()
  if (!fs.existsSync(filePath)) {
    return null
  }
  const store = readJsonFile(filePath)
  if (!store || typeof store !== "object" || !Array.isArray(store.accounts)) {
    return null
  }
  if (!store.activeIndexByFamily || typeof store.activeIndexByFamily !== "object") {
    store.activeIndexByFamily = {}
  }
  return store
}

function writeAntigravityAccountsStore(store) {
  writeJsonFile(getAntigravityAccountsPath(), store)
}

function getAntigravityConfig() {
  const filePath = getAntigravityConfigPath()
  if (!fs.existsSync(filePath)) {
    return null
  }
  return readJsonFile(filePath)
}

function isSecretField(key) {
  const normalized = String(key).toLowerCase()
  return normalized.includes("token") || normalized.includes("secret") || normalized.includes("key") || normalized === "access" || normalized === "refresh"
}

function redactSecret(value) {
  const text = String(value)
  if (!text) return "(empty)"
  if (text.length <= 8) return "*".repeat(text.length)
  return `${text.slice(0, 4)}...${text.slice(-4)}`
}

function formatDuration(ms) {
  const totalSeconds = Math.max(0, Math.floor(ms / 1000))
  const days = Math.floor(totalSeconds / 86400)
  const hours = Math.floor((totalSeconds % 86400) / 3600)
  const minutes = Math.floor((totalSeconds % 3600) / 60)
  const seconds = totalSeconds % 60

  if (days > 0) return `${days}d ${hours}h`
  if (hours > 0) return `${hours}h ${minutes}m`
  if (minutes > 0) return `${minutes}m ${seconds}s`
  return `${seconds}s`
}

function formatValue(key, value, options) {
  if (value === null) return "null"
  if (value === "") return "(empty)"

  if (typeof value === "number" && key === "expires") {
    const date = new Date(value)
    const iso = Number.isNaN(date.getTime()) ? "invalid-date" : date.toISOString()
    const delta = value - Date.now()
    const relative = delta >= 0 ? `in ${formatDuration(delta)}` : `${formatDuration(Math.abs(delta))} ago`
    return `${value} (${iso}, ${relative})`
  }

  if (typeof value === "string" && isSecretField(key)) {
    if (options.showSecrets) return value
    return `${redactSecret(value)} (${value.length} chars)`
  }

  if (Array.isArray(value)) return JSON.stringify(value)
  if (value && typeof value === "object") return JSON.stringify(value)
  return String(value)
}

function mapCredentialForJson(value, options, keyHint) {
  if (typeof value === "string" && isSecretField(keyHint)) {
    return options.showSecrets ? value : redactSecret(value)
  }
  if (Array.isArray(value)) {
    return value.map((item) => mapCredentialForJson(item, options, keyHint))
  }
  if (value && typeof value === "object") {
    return Object.fromEntries(
      Object.entries(value).map(([key, nested]) => [key, mapCredentialForJson(nested, options, key)]),
    )
  }
  return value
}

function sortCredentialKeys(keys) {
  const priority = new Map([
    ["type", 0],
    ["email", 1],
    ["projectId", 2],
    ["expires", 3],
  ])
  return [...keys].sort((left, right) => {
    const leftScore = priority.has(left) ? priority.get(left) : 100
    const rightScore = priority.has(right) ? priority.get(right) : 100
    if (leftScore !== rightScore) return leftScore - rightScore
    return left.localeCompare(right)
  })
}

function listCredentialEntries(auth, options) {
  return Object.entries(auth || {})
    .filter(([provider, credential]) => {
      if (options.provider && provider !== options.provider) return false
      if (options.type && (!credential || credential.type !== options.type)) return false
      return true
    })
    .sort(([left], [right]) => left.localeCompare(right))
}

function summarizeAuth(auth) {
  const providers = Object.entries(auth || {}).sort(([left], [right]) => left.localeCompare(right))
  return providers.map(([provider, credential]) => ({
    provider,
    type: credential?.type || "unknown",
    email: credential?.email || "",
    projectId: credential?.projectId || "",
  }))
}

function getPrimaryAuthEmail(auth) {
  for (const credential of Object.values(auth || {})) {
    if (credential && typeof credential === "object" && typeof credential.email === "string" && credential.email) {
      return credential.email
    }
  }
  return null
}

function getGoogleCredential(auth) {
  const credential = auth?.google
  return credential && typeof credential === "object" ? credential : null
}

function getAntigravityAccountByEmail(email) {
  if (!email) return null
  const store = getAntigravityAccountsStore()
  if (!store) return null
  const index = store.accounts.findIndex((account) => account && account.email === email)
  if (index === -1) return null
  return {
    index,
    account: store.accounts[index],
  }
}

function getAntigravityActiveIndexForFamily(store, family) {
  if (!store) return null
  const normalizedFamily = normalizeFamily(family)
  if (typeof store.activeIndexByFamily?.[normalizedFamily] === "number") {
    return store.activeIndexByFamily[normalizedFamily]
  }
  if (typeof store.activeIndex === "number") {
    return store.activeIndex
  }
  return null
}

function getActiveAntigravityAccountForFamily(family) {
  const store = getAntigravityAccountsStore()
  if (!store) return null
  const index = getAntigravityActiveIndexForFamily(store, family)
  if (typeof index !== "number" || index < 0 || index >= store.accounts.length) {
    return null
  }
  return {
    index,
    family: normalizeFamily(family),
    account: store.accounts[index],
  }
}

function getActiveAntigravityAccountEmail(family) {
  const result = getActiveAntigravityAccountForFamily(family)
  return result?.account?.email || null
}

function authSignature(auth) {
  return JSON.stringify(auth || {})
}

function getSortedProfileEntries(store) {
  return Object.entries(store.profiles || {}).sort(([left], [right]) => left.localeCompare(right))
}

function detectActiveProfile(store, currentAuth) {
  const current = authSignature(augmentAuthWithAntigravity(currentAuth))
  if (store.activeProfile) {
    const active = store.profiles?.[store.activeProfile]
    if (active && authSignature(augmentAuthWithAntigravity(active.auth || {})) === current) {
      return store.activeProfile
    }
  }
  for (const [name, profile] of Object.entries(store.profiles || {})) {
    if (authSignature(augmentAuthWithAntigravity(profile?.auth || {})) === current) {
      return name
    }
  }
  return null
}

function promptLine(promptText) {
  process.stdout.write(promptText)
  const buffer = Buffer.alloc(1)
  let input = ""
  for (;;) {
    const bytesRead = fs.readSync(0, buffer, 0, 1, null)
    if (bytesRead === 0) break
    const char = buffer.toString("utf8", 0, bytesRead)
    if (char === "\n") break
    if (char !== "\r") input += char
  }
  return input.trim()
}

function formatPercent(fraction) {
  if (typeof fraction !== "number" || !Number.isFinite(fraction)) return "n/a"
  return `${(fraction * 100).toFixed(0)}%`
}

function summarizeQuotaForAccount(account) {
  const quota = account?.cachedQuota || {}
  const parts = []
  if (quota["gemini-flash"]) parts.push(`flash ${formatPercent(quota["gemini-flash"].remainingFraction)}`)
  if (quota["gemini-pro"]) parts.push(`pro ${formatPercent(quota["gemini-pro"].remainingFraction)}`)
  if (quota.claude) parts.push(`claude ${formatPercent(quota.claude.remainingFraction)}`)
  return parts.length > 0 ? parts.join(", ") : "quota n/a"
}

function buildAuthFromAntigravityAccount(email, family) {
  const active = email ? getAntigravityAccountByEmail(email) : getActiveAntigravityAccountForFamily(family || DEFAULT_FAMILY)
  if (!active?.account) {
    console.error(`No Antigravity account available for ${email || normalizeFamily(family || DEFAULT_FAMILY)}`)
    process.exit(1)
  }

  const existingSources = [getAuthData(), ...Object.values(getProfilesStore().profiles || {}).map((profile) => profile.auth || {})]
  let base = null
  for (const candidate of existingSources) {
    if (getPrimaryAuthEmail(candidate) === active.account.email) {
      base = deepClone(candidate)
      break
    }
  }
  if (!base) {
    base = {
      google: {
        type: "oauth",
        refresh: active.account.refreshToken || "",
        access: "",
        expires: 0,
        email: active.account.email,
        projectId: active.account.projectId || "",
      },
    }
  }
  if (!base.google) base.google = { type: "oauth" }
  if (!base.google.type) base.google.type = "oauth"
  if (!base.google.refresh && active.account.refreshToken) base.google.refresh = active.account.refreshToken
  if (!base.google.email) base.google.email = active.account.email
  if (!base.google.projectId && active.account.projectId) base.google.projectId = active.account.projectId
  return base
}

function augmentAuthWithAntigravity(auth) {
  const next = deepClone(auth || {})
  const email = getPrimaryAuthEmail(next)
  const match = getAntigravityAccountByEmail(email)
  const credential = getGoogleCredential(next)
  if (credential && match?.account?.projectId && !credential.projectId) {
    credential.projectId = match.account.projectId
  }
  if (credential && match?.account?.refreshToken && !credential.refresh) {
    credential.refresh = match.account.refreshToken
  }
  return next
}

function syncAntigravitySelectionByEmail(email, family) {
  if (!email) return { status: "skipped", reason: "missing-email" }
  const store = getAntigravityAccountsStore()
  if (!store) return { status: "skipped", reason: "missing-store" }
  const normalizedFamily = normalizeFamily(family || DEFAULT_FAMILY)
  const index = store.accounts.findIndex((account) => account && account.email === email)
  if (index === -1) return { status: "skipped", reason: "not-found", email, family: normalizedFamily }
  store.activeIndexByFamily[normalizedFamily] = index
  if (normalizedFamily === DEFAULT_FAMILY) {
    store.activeIndex = index
  }
  if (store.accounts[index]) {
    store.accounts[index].lastUsed = Date.now()
  }
  writeAntigravityAccountsStore(store)
  return { status: "updated", email, index, family: normalizedFamily }
}

function getTokenHealth(auth) {
  const credential = getGoogleCredential(auth)
  if (!credential) return { hasCredential: false }
  const expires = typeof credential.expires === "number" ? credential.expires : 0
  const delta = expires - Date.now()
  return {
    hasCredential: true,
    expires,
    expired: expires > 0 ? delta <= 0 : false,
    relative: expires > 0 ? (delta >= 0 ? `in ${formatDuration(delta)}` : `${formatDuration(Math.abs(delta))} ago`) : "unknown",
    hasRefresh: Boolean(credential.refresh),
  }
}

function runPowerShellCapture(command) {
  const result = childProcess.spawnSync("powershell.exe", ["-NoProfile", "-NonInteractive", "-Command", command], {
    encoding: "utf8",
    windowsHide: true,
  })
  return {
    status: result.status,
    stdout: result.stdout || "",
    stderr: result.stderr || "",
    error: result.error,
  }
}

function getRunningOpencodeProcesses() {
  const result = runPowerShellCapture("Get-Process opencode -ErrorAction SilentlyContinue | Select-Object Id,ProcessName,Path | ConvertTo-Json -Compress")
  if (result.error || result.status !== 0 || !result.stdout.trim()) return []
  try {
    const parsed = JSON.parse(result.stdout)
    return Array.isArray(parsed) ? parsed : [parsed]
  } catch {
    return []
  }
}

function stopRunningOpencodeProcesses() {
  const running = getRunningOpencodeProcesses()
  if (running.length === 0) {
    return { count: 0 }
  }
  runPowerShellCapture("Get-Process opencode -ErrorAction SilentlyContinue | Stop-Process -Force")
  return { count: running.length }
}

function restartResolvedBinary(target) {
  const stopped = stopRunningOpencodeProcesses()
  const launcher = process.platform === "win32"
    ? `Start-Sleep -Milliseconds ${RESTART_DELAY_MS}; & '${target.replace(/'/g, "''")}'`
    : `sleep 1; '${target.replace(/'/g, "'\\''")}'`
  if (process.platform === "win32") {
    childProcess.spawn("powershell.exe", ["-NoProfile", "-WindowStyle", "Normal", "-Command", launcher], {
      detached: true,
      stdio: "ignore",
      windowsHide: false,
      cwd: process.cwd(),
    }).unref()
  } else {
    childProcess.spawn(target, [], {
      detached: true,
      stdio: "ignore",
      cwd: process.cwd(),
    }).unref()
  }
  return { stopped: stopped.count, relaunched: true }
}

function getRecentSessions() {
  const launcher = getAvailablePythonLauncher()
  if (!fs.existsSync(getOpencodeDbPath()) || !launcher) {
    return []
  }
  const script = [
    "import sqlite3, pathlib, json",
    "p = pathlib.Path.home()/'.local'/'share'/'opencode'/'opencode.db'",
    "con = sqlite3.connect(p)",
    "con.row_factory = sqlite3.Row",
    "cur = con.cursor()",
    "rows = cur.execute('select id, title, time_updated from session order by time_updated desc limit 5').fetchall()",
    "print(json.dumps([dict(r) for r in rows]))",
  ].join("; ")
  const result = childProcess.spawnSync(launcher.command, [...launcher.args, "-c", script], {
    encoding: "utf8",
    windowsHide: true,
  })
  if (result.status !== 0 || !result.stdout.trim()) return []
  try {
    const parsed = JSON.parse(result.stdout)
    return Array.isArray(parsed) ? parsed : []
  } catch {
    return []
  }
}

function collectStatus() {
  const auth = getAuthData()
  const profilesStore = getProfilesStore()
  const antigravityStore = getAntigravityAccountsStore()
  const antigravityConfig = getAntigravityConfig()
  const authEmail = getPrimaryAuthEmail(auth)
  const profileName = detectActiveProfile(profilesStore, auth) || profilesStore.activeProfile || null
  const geminiActive = getActiveAntigravityAccountForFamily("gemini")
  const claudeActive = getActiveAntigravityAccountForFamily("claude")
  const token = getTokenHealth(auth)
  const runningProcesses = getRunningOpencodeProcesses()
  const recentSessions = getRecentSessions()
  const drift = []
  const matchedAccount = getAntigravityAccountByEmail(authEmail)
  const googleCredential = getGoogleCredential(auth)

  if (!authEmail) drift.push({ code: "missing_auth_email", level: "fail", message: "auth.json has no email." })
  if (!matchedAccount) drift.push({ code: "missing_antigravity_account", level: "warn", message: authEmail ? `No Antigravity account matches ${authEmail}.` : "No Antigravity match for auth.json." })
  if (authEmail && geminiActive?.account?.email && authEmail !== geminiActive.account.email) {
    drift.push({
      code: "antigravity_gemini_mismatch",
      level: "warn",
      message: `Antigravity Gemini is ${geminiActive.account.email}, auth.json is ${authEmail}.`,
    })
  }
  if (googleCredential && !googleCredential.projectId && matchedAccount?.account?.projectId) {
    drift.push({
      code: "missing_auth_project_id",
      level: "warn",
      message: `auth.json is missing projectId while Antigravity has ${matchedAccount.account.projectId}.`,
    })
  }
  if (token.hasCredential && token.expired && token.hasRefresh) {
    drift.push({ code: "expired_access_token", level: "warn", message: `Access token expired ${token.relative}, but a refresh token exists.` })
  }
  if (token.hasCredential && token.expired && !token.hasRefresh) {
    drift.push({ code: "expired_without_refresh", level: "fail", message: `Access token expired ${token.relative} and no refresh token exists.` })
  }
  if (!profileName) {
    drift.push({ code: "untracked_profile", level: "warn", message: "Current auth.json does not match an active saved profile." })
  }

  return {
    paths: {
      auth: getAuthPath(),
      profiles: getProfilesPath(),
      antigravityAccounts: getAntigravityAccountsPath(),
      antigravityConfig: getAntigravityConfigPath(),
      opencodeDb: getOpencodeDbPath(),
    },
    profile: {
      activeProfile: profileName,
      savedProfileCount: Object.keys(profilesStore.profiles || {}).length,
    },
    auth: {
      email: authEmail,
      providerSummary: summarizeAuth(auth),
      token,
      projectId: googleCredential?.projectId || "",
    },
    antigravity: {
      config: antigravityConfig,
      accountCount: antigravityStore?.accounts?.length || 0,
      geminiActiveEmail: geminiActive?.account?.email || null,
      geminiActiveIndex: geminiActive?.index ?? null,
      claudeActiveEmail: claudeActive?.account?.email || null,
      claudeActiveIndex: claudeActive?.index ?? null,
      matchedEmail: matchedAccount?.account?.email || null,
      matchedIndex: matchedAccount?.index ?? null,
      matchedProjectId: matchedAccount?.account?.projectId || "",
      matchedQuota: matchedAccount?.account ? summarizeQuotaForAccount(matchedAccount.account) : null,
    },
    runtime: {
      processCount: runningProcesses.length,
      processes: runningProcesses,
      recentSessions,
    },
    drift,
  }
}

function printAuthRootHelp() {
  console.log(`opencode auth

Enhanced auth and account management for local auth.json and the Antigravity plugin store.

Commands:
  opencode auth list [options]           list credentials and drift warnings
  opencode auth profiles [--json]        list saved auth profiles
  opencode auth current [--json]         show active profile, auth store, plugin store, and runtime state
  opencode auth doctor [--json]          run auth consistency checks with repair hints
  opencode auth repair [--json]          repair common drift between auth.json and Antigravity
  opencode auth save <name> [options]    save current auth or an Antigravity account as a profile
  opencode auth switch [name] [options]  switch profile, sync Antigravity, optionally restart Opencode
  opencode auth rename <old> <new>       rename a saved profile
  opencode auth clone <src> <dst>        duplicate a saved profile
  opencode auth delete <name>            delete a saved profile

Notes:
  - The Antigravity plugin uses ${getAntigravityAccountsPath()}.
  - Standard Google auth uses ${getAuthPath()}.
  - current, doctor, and repair surface mismatches between the two stores.`)
}

