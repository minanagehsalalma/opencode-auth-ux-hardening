function parseEnhancedAuthListOptions(args) {
  const options = {
    family: DEFAULT_FAMILY,
    json: false,
    native: false,
    profiles: false,
    provider: undefined,
    restart: false,
    save: undefined,
    showSecrets: false,
    switch: undefined,
    type: undefined,
  }

  for (let i = 2; i < args.length; ) {
    const arg = args[i]
    if (arg === "--json") {
      options.json = true
      i += 1
      continue
    }
    if (arg === "--show-secrets") {
      options.showSecrets = true
      i += 1
      continue
    }
    if (arg === "--profiles") {
      options.profiles = true
      i += 1
      continue
    }
    if (arg === "--restart") {
      options.restart = true
      i += 1
      continue
    }
    if (arg === "--native") {
      options.native = true
      i += 1
      continue
    }
    if (arg === "-h" || arg === "--help") {
      printEnhancedAuthListHelp()
      process.exit(0)
    }

    const providerArg = parseNamedValueArg(args, i, "--provider")
    if (providerArg) {
      options.provider = providerArg.value
      i += providerArg.consumed
      continue
    }

    const typeArg = parseNamedValueArg(args, i, "--type")
    if (typeArg) {
      options.type = typeArg.value
      i += typeArg.consumed
      continue
    }

    const saveArg = parseNamedValueArg(args, i, "--save")
    if (saveArg) {
      options.save = saveArg.value
      i += saveArg.consumed
      continue
    }

    const familyArg = parseNamedValueArg(args, i, "--family")
    if (familyArg) {
      options.family = normalizeFamily(familyArg.value)
      i += familyArg.consumed
      continue
    }

    if (arg === "--switch") {
      const next = args[i + 1]
      options.switch = !next || next.startsWith("-") ? INTERACTIVE_SWITCH : normalizeSwitchValue(next)
      i += !next || next.startsWith("-") ? 1 : 2
      continue
    }
    if (arg.startsWith("--switch=")) {
      options.switch = normalizeSwitchValue(arg.slice("--switch=".length))
      i += 1
      continue
    }

    if (arg === "--print-logs" || arg === "--pure" || arg === "--log-level" || arg.startsWith("--log-level=")) {
      options.native = true
      i += 1
      continue
    }

    console.error(`Unknown enhanced auth list option: ${arg}`)
    console.error('Use "opencode auth list --help" for enhanced options or add --native to use the bundled binary output.')
    process.exit(1)
  }

  if (options.save && typeof options.switch !== "undefined") {
    console.error("Use either --save or --switch, not both in the same command.")
    process.exit(1)
  }

  return options
}

function parseProfilesOptions(args) {
  const options = { json: false }
  for (let i = 2; i < args.length; i += 1) {
    const arg = args[i]
    if (arg === "--json") {
      options.json = true
      continue
    }
    if (arg === "-h" || arg === "--help") {
      printEnhancedProfilesHelp()
      process.exit(0)
    }
    console.error(`Unknown auth profiles option: ${arg}`)
    process.exit(1)
  }
  return options
}

function parseCurrentLikeOptions(args, helpPrinter) {
  const options = { json: false }
  for (let i = 2; i < args.length; i += 1) {
    const arg = args[i]
    if (arg === "--json") {
      options.json = true
      continue
    }
    if (arg === "-h" || arg === "--help") {
      helpPrinter()
      process.exit(0)
    }
    console.error(`Unknown option: ${arg}`)
    process.exit(1)
  }
  return options
}

function parseSwitchOptions(args) {
  const options = {
    family: DEFAULT_FAMILY,
    profileName: args[2] && !args[2].startsWith("-") ? normalizeSwitchValue(args[2]) : INTERACTIVE_SWITCH,
    restart: false,
  }
  const startIndex = args[2] && !args[2].startsWith("-") ? 3 : 2
  for (let i = startIndex; i < args.length; ) {
    const arg = args[i]
    if (arg === "--restart") {
      options.restart = true
      i += 1
      continue
    }
    const familyArg = parseNamedValueArg(args, i, "--family")
    if (familyArg) {
      options.family = normalizeFamily(familyArg.value)
      i += familyArg.consumed
      continue
    }
    if (arg === "-h" || arg === "--help") {
      printEnhancedSwitchHelp()
      process.exit(0)
    }
    console.error(`Unknown auth switch option: ${arg}`)
    process.exit(1)
  }
  return options
}

function parseSaveOptions(args) {
  if (args.includes("-h") || args.includes("--help")) {
    printEnhancedSaveHelp()
    process.exit(0)
  }
  const profileName = args[2]
  const options = {
    family: DEFAULT_FAMILY,
    fromAntigravity: false,
    antigravityEmail: undefined,
    profileName,
  }
  for (let i = 3; i < args.length; ) {
    const arg = args[i]
    const familyArg = parseNamedValueArg(args, i, "--family")
    if (familyArg) {
      options.family = normalizeFamily(familyArg.value)
      i += familyArg.consumed
      continue
    }
    if (arg === "--from-antigravity") {
      const next = args[i + 1]
      options.fromAntigravity = true
      options.antigravityEmail = !next || next.startsWith("-") ? undefined : next
      i += !next || next.startsWith("-") ? 1 : 2
      continue
    }
    if (arg.startsWith("--from-antigravity=")) {
      options.fromAntigravity = true
      options.antigravityEmail = arg.slice("--from-antigravity=".length)
      i += 1
      continue
    }
    console.error(`Unknown auth save option: ${arg}`)
    process.exit(1)
  }
  return options
}

function saveProfile(profileName, options = {}) {
  if (!profileName) {
    console.error("Missing profile name. Usage: opencode auth save <name>")
    process.exit(1)
  }

  const auth = options.fromAntigravity
    ? buildAuthFromAntigravityAccount(options.antigravityEmail, options.family)
    : augmentAuthWithAntigravity(getAuthData())

  const store = getProfilesStore()
  const currentActiveProfile = detectActiveProfile(store, getAuthData()) || store.activeProfile || null
  store.profiles[profileName] = {
    savedAt: new Date().toISOString(),
    auth: deepClone(auth),
  }
  store.activeProfile = currentActiveProfile || profileName
  writeProfilesStore(store)
  return store.profiles[profileName]
}

function renameProfile(sourceName, targetName) {
  const store = getProfilesStore()
  if (!sourceName || !targetName) {
    console.error("Usage: opencode auth rename <old> <new>")
    process.exit(1)
  }
  if (!store.profiles[sourceName]) {
    console.error(`Unknown auth profile: ${sourceName}`)
    process.exit(1)
  }
  if (store.profiles[targetName]) {
    console.error(`Target auth profile already exists: ${targetName}`)
    process.exit(1)
  }
  store.profiles[targetName] = store.profiles[sourceName]
  delete store.profiles[sourceName]
  if (store.activeProfile === sourceName) {
    store.activeProfile = targetName
  }
  writeProfilesStore(store)
}

function deleteProfile(profileName) {
  const store = getProfilesStore()
  if (!profileName) {
    console.error("Usage: opencode auth delete <name>")
    process.exit(1)
  }
  if (!store.profiles[profileName]) {
    console.error(`Unknown auth profile: ${profileName}`)
    process.exit(1)
  }
  delete store.profiles[profileName]
  if (store.activeProfile === profileName) {
    store.activeProfile = null
  }
  writeProfilesStore(store)
}

function cloneProfile(sourceName, targetName) {
  const store = getProfilesStore()
  if (!sourceName || !targetName) {
    console.error("Usage: opencode auth clone <src> <dst>")
    process.exit(1)
  }
  if (!store.profiles[sourceName]) {
    console.error(`Unknown auth profile: ${sourceName}`)
    process.exit(1)
  }
  if (store.profiles[targetName]) {
    console.error(`Target auth profile already exists: ${targetName}`)
    process.exit(1)
  }
  store.profiles[targetName] = {
    savedAt: new Date().toISOString(),
    auth: deepClone(store.profiles[sourceName].auth || {}),
  }
  writeProfilesStore(store)
}

function selectProfileInteractively(reason, family) {
  const store = getProfilesStore()
  const entries = getSortedProfileEntries(store)
  if (entries.length === 0) {
    console.error("No saved auth profiles exist yet. Save one with: opencode auth save <name>")
    process.exit(1)
  }

  const currentAuth = fs.existsSync(getAuthPath()) ? getAuthData() : {}
  const activeProfile = detectActiveProfile(store, currentAuth) || store.activeProfile || null
  const normalizedFamily = normalizeFamily(family || DEFAULT_FAMILY)
  const activeFamilyEmail = getActiveAntigravityAccountEmail(normalizedFamily)

  console.log(reason)
  console.log("")

  entries.forEach(([name, profile], index) => {
    const email = getPrimaryAuthEmail(profile.auth || {})
    const antigravity = getAntigravityAccountByEmail(email)
    const badges = []
    if (name === activeProfile) badges.push("profile-active")
    if (email && email === activeFamilyEmail) badges.push(`${normalizedFamily}-active`)
    if (!antigravity) badges.push("no-antigravity")
    const badgeText = badges.length > 0 ? ` [${badges.join(", ")}]` : ""
    console.log(`${index + 1}. ${name}${badgeText}`)
    console.log(`   savedAt: ${profile?.savedAt || "unknown"}`)
    for (const item of summarizeAuth(profile?.auth || {})) {
      const emailText = item.email ? `, ${item.email}` : ""
      const projectText = item.projectId ? `, project ${item.projectId}` : ""
      console.log(`   ${item.provider}: ${item.type}${emailText}${projectText}`)
    }
    if (antigravity?.account) {
      console.log(`   antigravity: ${summarizeQuotaForAccount(antigravity.account)}${antigravity.account.projectId ? `, project ${antigravity.account.projectId}` : ""}`)
    }
    if (index < entries.length - 1) console.log("")
  })

  console.log("")
  const input = promptLine("Select profile by number or name: ")
  if (!input) {
    console.error("No profile selected.")
    process.exit(1)
  }
  if (/^\d+$/.test(input)) {
    const numericIndex = Number.parseInt(input, 10)
    if (numericIndex < 1 || numericIndex > entries.length) {
      console.error(`Invalid profile number: ${input}`)
      process.exit(1)
    }
    return entries[numericIndex - 1][0]
  }
  const exactMatch = entries.find(([name]) => name === input)
  if (exactMatch) return exactMatch[0]
  console.error(`Unknown auth profile selection: ${input}`)
  console.error(`Available profiles: ${entries.map(([name]) => name).join(", ")}`)
  process.exit(1)
}

function switchProfile(profileName, options = {}) {
  const normalizedFamily = normalizeFamily(options.family || DEFAULT_FAMILY)
  const selectedProfileName = normalizeSwitchValue(profileName) === INTERACTIVE_SWITCH
    ? selectProfileInteractively(options.promptReason || "Select an auth profile to switch to:", normalizedFamily)
    : profileName

  if (!selectedProfileName) {
    console.error("Missing profile name. Usage: opencode auth switch <name>")
    process.exit(1)
  }

  const store = getProfilesStore()
  const profile = store.profiles[selectedProfileName]
  if (!profile) {
    const names = Object.keys(store.profiles || {}).sort()
    console.error(`Unknown auth profile: ${selectedProfileName}`)
    if (names.length > 0) {
      console.error(`Available profiles: ${names.join(", ")}`)
    } else {
      console.error("No saved auth profiles exist yet. Save one with: opencode auth save <name>")
    }
    process.exit(1)
  }

  const authData = augmentAuthWithAntigravity(deepClone(profile.auth || {}))
  writeAuthData(authData)
  const synced = syncAntigravitySelectionByEmail(getPrimaryAuthEmail(authData), normalizedFamily)
  store.activeProfile = selectedProfileName
  writeProfilesStore(store)
  return {
    name: selectedProfileName,
    profile,
    synced,
    authData,
  }
}

function repairState() {
  const status = collectStatus()
  const actions = []
  const auth = getAuthData()
  const store = getProfilesStore()
  const authEmail = status.auth.email
  const googleCredential = getGoogleCredential(auth)

  if (authEmail) {
    const syncResult = syncAntigravitySelectionByEmail(authEmail, "gemini")
    if (syncResult.status === "updated") {
      actions.push(`synced Antigravity Gemini active account to ${authEmail}`)
    }
  }

  const augmented = augmentAuthWithAntigravity(auth)
  if (JSON.stringify(augmented) !== JSON.stringify(auth)) {
    writeAuthData(augmented)
    if (!googleCredential?.projectId && getGoogleCredential(augmented)?.projectId) {
      actions.push(`backfilled auth.json projectId to ${getGoogleCredential(augmented).projectId}`)
    } else {
      actions.push("updated auth.json from Antigravity metadata")
    }
  }

  const detectedProfile = detectActiveProfile(store, augmented)
  if (detectedProfile && store.activeProfile !== detectedProfile) {
    store.activeProfile = detectedProfile
    writeProfilesStore(store)
    actions.push(`set active profile to ${detectedProfile}`)
  }

  if (detectedProfile && store.profiles[detectedProfile]) {
    const profileAuth = augmentAuthWithAntigravity(store.profiles[detectedProfile].auth || {})
    if (JSON.stringify(profileAuth) !== JSON.stringify(store.profiles[detectedProfile].auth || {})) {
      store.profiles[detectedProfile].auth = profileAuth
      writeProfilesStore(store)
      actions.push(`updated profile ${detectedProfile} with Antigravity metadata`)
    }
  }

  return {
    before: status,
    after: collectStatus(),
    actions,
  }
}

function buildDoctorChecks(status) {
  const checks = []
  checks.push({
    code: "auth_file",
    level: status.auth.email ? "ok" : "fail",
    message: status.auth.email ? `auth.json loaded for ${status.auth.email}` : "auth.json has no email",
  })
  checks.push({
    code: "profiles_store",
    level: status.profile.savedProfileCount > 0 ? "ok" : "warn",
    message: `${status.profile.savedProfileCount} saved profile${status.profile.savedProfileCount === 1 ? "" : "s"}`,
  })
  checks.push({
    code: "antigravity_store",
    level: status.antigravity.accountCount > 0 ? "ok" : "warn",
    message: `${status.antigravity.accountCount} Antigravity account${status.antigravity.accountCount === 1 ? "" : "s"}`,
  })
  checks.push({
    code: "gemini_sync",
    level: status.auth.email && status.antigravity.geminiActiveEmail === status.auth.email ? "ok" : "warn",
    message: status.antigravity.geminiActiveEmail
      ? `Gemini active account: ${status.antigravity.geminiActiveEmail}`
      : "No Gemini active account found",
  })
  checks.push({
    code: "project_id",
    level: status.auth.projectId
      ? "ok"
      : status.antigravity.matchedProjectId
        ? "warn"
        : "warn",
    message: status.auth.projectId
      ? `auth.json projectId: ${status.auth.projectId}`
      : status.antigravity.matchedProjectId
        ? `auth.json missing projectId; Antigravity has ${status.antigravity.matchedProjectId}`
        : "No projectId available",
  })
  checks.push({
    code: "token_health",
    level: !status.auth.token.hasCredential
      ? "fail"
      : status.auth.token.expired
        ? status.auth.token.hasRefresh ? "warn" : "fail"
        : "ok",
    message: !status.auth.token.hasCredential
      ? "No Google credential found"
      : status.auth.token.expires
        ? `Access token ${status.auth.token.expired ? "expired" : "valid"} ${status.auth.token.relative}`
        : "Access token expiry unknown",
  })
  checks.push({
    code: "runtime_processes",
    level: status.runtime.processCount > 0 ? "warn" : "ok",
    message: `${status.runtime.processCount} running Opencode process${status.runtime.processCount === 1 ? "" : "es"}`,
  })
  return checks.concat(status.drift)
}

function printCurrentStatus(status, asJson) {
  if (asJson) {
    console.log(JSON.stringify(status, null, 2))
    process.exit(0)
  }

  console.log("Auth Current")
  console.log("")
  console.log(`profile: ${status.profile.activeProfile || "(none)"}`)
  console.log(`auth.json: ${status.auth.email || "(missing)"}`)
  console.log(`antigravity gemini: ${status.antigravity.geminiActiveEmail || "(none)"}`)
  console.log(`antigravity claude: ${status.antigravity.claudeActiveEmail || "(none)"}`)
  console.log(`saved profiles: ${status.profile.savedProfileCount}`)
  console.log(`running opencode processes: ${status.runtime.processCount}`)
  console.log(`recent sessions: ${status.runtime.recentSessions.length}`)
  if (status.auth.projectId || status.antigravity.matchedProjectId) {
    console.log(`projectId: ${status.auth.projectId || `(from antigravity: ${status.antigravity.matchedProjectId})`}`)
  }
  if (status.antigravity.matchedQuota) {
    console.log(`quota: ${status.antigravity.matchedQuota}`)
  }
  console.log("")
  if (status.drift.length === 0) {
    console.log("drift: none")
  } else {
    console.log("drift:")
    for (const item of status.drift) {
      console.log(`  [${item.level.toUpperCase()}] ${item.message}`)
    }
  }
  if (status.runtime.processCount > 0) {
    console.log("")
    console.log("note: live Opencode sessions may need restart to pick up account changes.")
  }
  process.exit(0)
}

function printDoctor(status, asJson) {
  const checks = buildDoctorChecks(status)
  const payload = {
    status,
    checks,
    recommendedActions: checks.filter((item) => item.level !== "ok").map((item) => {
      if (item.code === "antigravity_gemini_mismatch") return "Run `opencode auth repair` or `opencode auth switch --restart`."
      if (item.code === "missing_auth_project_id") return "Run `opencode auth repair` to backfill projectId from Antigravity."
      if (item.code === "runtime_processes") return "Use `opencode auth switch --restart` after changing accounts."
      if (item.code === "expired_access_token") return "Refresh via login flow if commands start failing."
      if (item.code === "missing_antigravity_account") return "Add the account to Antigravity or switch to an account it knows."
      return item.message
    }),
  }

  if (asJson) {
    console.log(JSON.stringify(payload, null, 2))
    process.exit(0)
  }

  console.log("Auth Doctor")
  console.log("")
  for (const item of checks) {
    console.log(`[${item.level.toUpperCase()}] ${item.message}`)
  }
  if (payload.recommendedActions.length > 0) {
    console.log("")
    console.log("recommended:")
    for (const action of payload.recommendedActions) {
      console.log(`  - ${action}`)
    }
  }
  process.exit(0)
}

function printRepairResult(result, asJson) {
  if (asJson) {
    console.log(JSON.stringify(result, null, 2))
    process.exit(0)
  }
  console.log("Auth Repair")
  console.log("")
  if (result.actions.length === 0) {
    console.log("No repairs were needed.")
  } else {
    for (const action of result.actions) {
      console.log(`- ${action}`)
    }
  }
  if (result.after.drift.length > 0) {
    console.log("")
    console.log("remaining drift:")
    for (const item of result.after.drift) {
      console.log(`  [${item.level.toUpperCase()}] ${item.message}`)
    }
  }
  process.exit(0)
}

function printCredentialList(auth, options) {
  const entries = listCredentialEntries(auth, options)
  const authEmail = getPrimaryAuthEmail(auth)
  const antigravityEmail = getActiveAntigravityAccountEmail(options.family)

  if (options.json) {
    const credentials = Object.fromEntries(
      entries.map(([provider, credential]) => [provider, mapCredentialForJson(credential, options, provider)]),
    )
    console.log(
      JSON.stringify(
        {
          path: getAuthPath(),
          count: entries.length,
          credentials,
          antigravityActiveEmail: antigravityEmail,
          family: options.family,
          drift: authEmail && antigravityEmail && authEmail !== antigravityEmail,
        },
        null,
        2,
      ),
    )
    process.exit(0)
  }

  console.log(`Credentials ${getAuthPath()}`)
  console.log("")

  if (authEmail && antigravityEmail && authEmail !== antigravityEmail) {
    console.log(`Warning: Antigravity ${options.family} active account is ${antigravityEmail}, but auth.json is ${authEmail}.`)
    console.log("Use `opencode auth switch` or `opencode auth repair` to sync both stores.")
    console.log("")
  }

  if (entries.length === 0) {
    console.log("No credentials matched the current filters.")
    process.exit(0)
  }

  entries.forEach(([provider, credential], index) => {
    console.log(`${index + 1}. ${provider}`)
    for (const key of sortCredentialKeys(Object.keys(credential || {}))) {
      console.log(`   ${key}: ${formatValue(key, credential[key], options)}`)
    }
    const ag = getAntigravityAccountByEmail(credential?.email)
    if (ag?.account) {
      console.log(`   antigravity: ${summarizeQuotaForAccount(ag.account)}${ag.account.projectId ? `, project ${ag.account.projectId}` : ""}`)
    }
    if (index < entries.length - 1) console.log("")
  })

  console.log("")
  console.log(`${entries.length} credential${entries.length === 1 ? "" : "s"}`)
  process.exit(0)
}

function printProfilesList(options) {
  const store = getProfilesStore()
  const currentAuth = fs.existsSync(getAuthPath()) ? getAuthData() : {}
  const detectedActive = detectActiveProfile(store, currentAuth)
  const activeProfile = detectedActive || store.activeProfile || null
  const entries = getSortedProfileEntries(store)
  const family = DEFAULT_FAMILY
  const activeFamilyEmail = getActiveAntigravityAccountEmail(family)

  if (options.json) {
    console.log(
      JSON.stringify(
        {
          path: getProfilesPath(),
          activeProfile,
          count: entries.length,
          profiles: Object.fromEntries(
            entries.map(([name, profile]) => {
              const email = getPrimaryAuthEmail(profile?.auth || {})
              const antigravity = getAntigravityAccountByEmail(email)
              return [
                name,
                {
                  savedAt: profile?.savedAt || null,
                  summary: summarizeAuth(profile?.auth || {}),
                  antigravity: antigravity?.account
                    ? {
                        email: antigravity.account.email,
                        index: antigravity.index,
                        quota: summarizeQuotaForAccount(antigravity.account),
                        projectId: antigravity.account.projectId || "",
                        activeForGemini: antigravity.account.email === activeFamilyEmail,
                      }
                    : null,
                },
              ]
            }),
          ),
        },
        null,
        2,
      ),
    )
    process.exit(0)
  }

  console.log(`Auth Profiles ${getProfilesPath()}`)
  console.log("")

  if (entries.length === 0) {
    console.log("No saved auth profiles.")
    console.log("Save the current credentials with: opencode auth save <name>")
    process.exit(0)
  }

  entries.forEach(([name, profile], index) => {
    const email = getPrimaryAuthEmail(profile?.auth || {})
    const antigravity = getAntigravityAccountByEmail(email)
    const marker = name === activeProfile ? "*" : " "
    const badge = email && email === activeFamilyEmail ? " [gemini-active]" : ""
    console.log(`${marker} ${name}${badge}`)
    console.log(`   savedAt: ${profile?.savedAt || "unknown"}`)
    for (const item of summarizeAuth(profile?.auth || {})) {
      const emailText = item.email ? `, ${item.email}` : ""
      const projectText = item.projectId ? `, project ${item.projectId}` : ""
      console.log(`   ${item.provider}: ${item.type}${emailText}${projectText}`)
    }
    if (antigravity?.account) {
      console.log(`   antigravity: ${summarizeQuotaForAccount(antigravity.account)}${antigravity.account.projectId ? `, project ${antigravity.account.projectId}` : ""}`)
    } else {
      console.log("   antigravity: no matching account")
    }
    if (index < entries.length - 1) console.log("")
  })

  console.log("")
  console.log(`${entries.length} profile${entries.length === 1 ? "" : "s"}`)
  if (activeProfile) console.log(`Active profile: ${activeProfile}`)
  process.exit(0)
}

function maybeWarnOnLaunch(args) {
  if (args.length > 0 && isAuthRoot(args[0])) return
  if (args.includes("--help") || args.includes("-h") || args.includes("--version") || args.includes("-v")) return
  try {
    const status = collectStatus()
    const mismatch = status.drift.find((item) => item.code === "antigravity_gemini_mismatch")
    if (mismatch) {
      console.error(`[auth] Warning: ${mismatch.message}`)
      console.error("[auth] Run `opencode auth repair` or `opencode auth switch --restart` before starting a new session.")
    }
  } catch {
    // ignore launch-time warnings on read failure
  }
}

function handleEnhancedAuthRoot(args) {
  if (!isAuthRootHelpRequest(args)) return false
  printAuthRootHelp()
  process.exit(0)
}

function handleEnhancedAuthList(args, resolvedBinary) {
  if (!isAuthListCommand(args)) return false

  const options = parseEnhancedAuthListOptions(args)
  if (options.native) {
    process.argv = process.argv.filter((arg) => arg !== "--native")
    return false
  }

  if (options.save) {
    saveProfile(options.save)
    console.log(`Saved current credentials as profile: ${options.save}`)
    console.log("")
  }

  if (typeof options.switch !== "undefined") {
    const result = switchProfile(options.switch, {
      family: options.family,
      promptReason: "Select a profile to switch to before listing credentials:",
    })
    console.log(`Switched active credentials to profile: ${result.name}`)
    if (result.synced?.status === "updated") {
      console.log(`Synced Antigravity ${result.synced.family} active account to: ${result.synced.email}`)
    }
    if (options.restart) {
      const restarted = restartResolvedBinary(resolvedBinary)
      console.log(`Restart requested: stopped ${restarted.stopped} Opencode process${restarted.stopped === 1 ? "" : "es"} and launched a fresh session.`)
    }
    console.log("")
  }

  if (options.profiles) {
    printProfilesList(options)
  }

  const auth = getAuthData()
  printCredentialList(auth, options)
}

function handleEnhancedAuthSave(args) {
  if (!isAuthSaveCommand(args)) return false
  const options = parseSaveOptions(args)
  saveProfile(options.profileName, options)
  console.log(`Saved ${options.fromAntigravity ? "Antigravity" : "current"} credentials as profile: ${options.profileName}`)
  process.exit(0)
}

function handleEnhancedAuthSwitch(args, resolvedBinary) {
  if (!isAuthSwitchCommand(args)) return false
  const options = parseSwitchOptions(args)
  const result = switchProfile(options.profileName, {
    family: options.family,
    promptReason: "Select a profile to switch to:",
  })
  console.log(`Switched active credentials to profile: ${result.name}`)
  if (result.synced?.status === "updated") {
    console.log(`Synced Antigravity ${result.synced.family} active account to: ${result.synced.email}`)
  }
  if (options.restart) {
    const restarted = restartResolvedBinary(resolvedBinary)
    console.log(`Restart requested: stopped ${restarted.stopped} Opencode process${restarted.stopped === 1 ? "" : "es"} and launched a fresh session.`)
  }
  process.exit(0)
}

function handleEnhancedAuthProfiles(args) {
  if (!isAuthProfilesCommand(args)) return false
  const options = parseProfilesOptions(args)
  printProfilesList(options)
}

function handleEnhancedAuthCurrent(args) {
  if (!isAuthCurrentCommand(args)) return false
  const options = parseCurrentLikeOptions(args, printEnhancedCurrentHelp)
  printCurrentStatus(collectStatus(), options.json)
}

function handleEnhancedAuthDoctor(args) {
  if (!isAuthDoctorCommand(args)) return false
  const options = parseCurrentLikeOptions(args, printEnhancedDoctorHelp)
  printDoctor(collectStatus(), options.json)
}

function handleEnhancedAuthRepair(args) {
  if (!isAuthRepairCommand(args)) return false
  const options = parseCurrentLikeOptions(args, printEnhancedRepairHelp)
  printRepairResult(repairState(), options.json)
}

function handleEnhancedAuthRename(args) {
  if (!isAuthRenameCommand(args)) return false
  if (args.includes("-h") || args.includes("--help")) {
    console.log("opencode auth rename <old> <new>")
    process.exit(0)
  }
  renameProfile(args[2], args[3])
  console.log(`Renamed auth profile ${args[2]} -> ${args[3]}`)
  process.exit(0)
}

function handleEnhancedAuthDelete(args) {
  if (!isAuthDeleteCommand(args)) return false
  if (args.includes("-h") || args.includes("--help")) {
    console.log("opencode auth delete <name>")
    process.exit(0)
  }
  deleteProfile(args[2])
  console.log(`Deleted auth profile: ${args[2]}`)
  process.exit(0)
}

function handleEnhancedAuthClone(args) {
  if (!isAuthCloneCommand(args)) return false
  if (args.includes("-h") || args.includes("--help")) {
    console.log("opencode auth clone <src> <dst>")
    process.exit(0)
  }
  cloneProfile(args[2], args[3])
  console.log(`Cloned auth profile ${args[2]} -> ${args[3]}`)
  process.exit(0)
}

function handleCustomAuthCommands(args, resolvedBinary) {
  if (handleEnhancedAuthRoot(args)) return true
  if (handleEnhancedAuthList(args, resolvedBinary)) return true
  if (handleEnhancedAuthSave(args)) return true
  if (handleEnhancedAuthSwitch(args, resolvedBinary)) return true
  if (handleEnhancedAuthProfiles(args)) return true
  if (handleEnhancedAuthCurrent(args)) return true
  if (handleEnhancedAuthDoctor(args)) return true
  if (handleEnhancedAuthRepair(args)) return true
  if (handleEnhancedAuthRename(args)) return true
  if (handleEnhancedAuthDelete(args)) return true
  if (handleEnhancedAuthClone(args)) return true
  return false
}

function run(target) {
  const result = childProcess.spawnSync(target, process.argv.slice(2), {
    stdio: "inherit",
  })
  if (result.error) {
    console.error(result.error.message)
    process.exit(1)
  }
  const code = typeof result.status === "number" ? result.status : 0
  process.exit(code)
}

const envPath = process.env.OPENCODE_BIN_PATH
if (envPath) {
  handleCustomAuthCommands(process.argv.slice(2), envPath)
  maybeWarnOnLaunch(process.argv.slice(2))
  run(envPath)
}

const scriptPath = fs.realpathSync(__filename)
const scriptDir = path.dirname(scriptPath)

const cached = path.join(scriptDir, ".opencode")
if (fs.existsSync(cached)) {
  handleCustomAuthCommands(process.argv.slice(2), cached)
  maybeWarnOnLaunch(process.argv.slice(2))
  run(cached)
}

const platformMap = {
  darwin: "darwin",
  linux: "linux",
  win32: "windows",
}
const archMap = {
  x64: "x64",
  arm64: "arm64",
  arm: "arm",
}

let platform = platformMap[os.platform()]
if (!platform) platform = os.platform()
let arch = archMap[os.arch()]
if (!arch) arch = os.arch()
const base = "opencode-" + platform + "-" + arch
const binary = platform === "windows" ? "opencode.exe" : "opencode"

function supportsAvx2() {
  if (arch !== "x64") return false

  if (platform === "linux") {
    try {
      return /(^|\s)avx2(\s|$)/i.test(fs.readFileSync("/proc/cpuinfo", "utf8"))
    } catch {
      return false
    }
  }

  if (platform === "darwin") {
    try {
      const result = childProcess.spawnSync("sysctl", ["-n", "hw.optional.avx2_0"], {
        encoding: "utf8",
        timeout: 1500,
      })
      if (result.status !== 0) return false
      return (result.stdout || "").trim() === "1"
    } catch {
      return false
    }
  }

  if (platform === "windows") {
    const cmd = '(Add-Type -MemberDefinition "[DllImport(""kernel32.dll"")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)'
    for (const exe of ["powershell.exe", "pwsh.exe", "pwsh", "powershell"]) {
      try {
        const result = childProcess.spawnSync(exe, ["-NoProfile", "-NonInteractive", "-Command", cmd], {
          encoding: "utf8",
          timeout: 3000,
          windowsHide: true,
        })
        if (result.status !== 0) continue
        const out = (result.stdout || "").trim().toLowerCase()
        if (out === "true" || out === "1") return true
        if (out === "false" || out === "0") return false
      } catch {
        continue
      }
    }
    return false
  }

  return false
}

const names = (() => {
  const avx2 = supportsAvx2()
  const baseline = arch === "x64" && !avx2

  if (platform === "linux") {
    const musl = (() => {
      try {
        if (fs.existsSync("/etc/alpine-release")) return true
      } catch {}
      try {
        const result = childProcess.spawnSync("ldd", ["--version"], { encoding: "utf8" })
        const text = ((result.stdout || "") + (result.stderr || "")).toLowerCase()
        if (text.includes("musl")) return true
      } catch {}
      return false
    })()

    if (musl) {
      if (arch === "x64") {
        if (baseline) return [`${base}-baseline-musl`, `${base}-musl`, `${base}-baseline`, base]
        return [`${base}-musl`, `${base}-baseline-musl`, base, `${base}-baseline`]
      }
      return [`${base}-musl`, base]
    }

    if (arch === "x64") {
      if (baseline) return [`${base}-baseline`, base, `${base}-baseline-musl`, `${base}-musl`]
      return [base, `${base}-baseline`, `${base}-musl`, `${base}-baseline-musl`]
    }
    return [base, `${base}-musl`]
  }

  if (arch === "x64") {
    if (baseline) return [`${base}-baseline`, base]
    return [base, `${base}-baseline`]
  }
  return [base]
})()

function findBinary(startDir) {
  let current = startDir
  for (;;) {
    const modules = path.join(current, "node_modules")
    if (fs.existsSync(modules)) {
      for (const name of names) {
        const candidate = path.join(modules, name, "bin", binary)
        if (fs.existsSync(candidate)) return candidate
      }
    }
    const parent = path.dirname(current)
    if (parent === current) return undefined
    current = parent
  }
}

const resolved = findBinary(scriptDir)
if (!resolved) {
  console.error(
    "It seems that your package manager failed to install the right version of the opencode CLI for your platform. You can try manually installing " +
      names.map((n) => `\"${n}\"`).join(" or ") +
      " package",
  )
  process.exit(1)
}

handleCustomAuthCommands(process.argv.slice(2), resolved)
maybeWarnOnLaunch(process.argv.slice(2))
run(resolved)
