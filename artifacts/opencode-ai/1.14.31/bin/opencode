  console.log(`opencode auth list

Enhanced local formatter for ${path.join("~", ".local", "share", "opencode", "auth.json")}

Options:
  --json              print filtered credentials as JSON
  --provider <name>   filter to one provider (for example: google)
  --type <type>       filter by credential type (for example: oauth)
  --show-secrets      reveal full token/key values instead of redacting them
  --save <name>       save current auth.json as a named profile
  --switch [name]     switch auth.json to a saved profile before listing; omit name for interactive selection
  --profiles          list saved auth profiles instead of current credentials
  --family <name>     Antigravity family to sync when switching (gemini or claude)
  --restart           restart Opencode after a successful switch
  --native            bypass this formatter and run the bundled opencode binary
  -h, --help          show help`)
}

