+  const defaultVariant = DEFAULT_MODEL_VARIANTS[requestedModel.model]
+  if (!defaultVariant) {
+    return nextArgs
+  }
+
+  nextArgs.splice(requestedModel.insertIndex, 0, "--variant", defaultVariant)
+  return nextArgs
+}
