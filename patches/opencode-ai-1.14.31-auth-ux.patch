+function buildDoctorChecks(status) {
+  const checks = []
+  checks.push({
+    code: "auth_file",
+    level: status.auth.email ? "ok" : "fail",
+    message: status.auth.email ? `auth.json loaded for ${status.auth.email}` : "auth.json has no email",
+  })
+  checks.push({
+    code: "profiles_store",
+    level: status.profile.savedProfileCount > 0 ? "ok" : "warn",
+    message: `${status.profile.savedProfileCount} saved profile${status.profile.savedProfileCount === 1 ? "" : "s"}`,
+  })
+  checks.push({
+    code: "antigravity_store",
+    level: status.antigravity.accountCount > 0 ? "ok" : "warn",
+    message: `${status.antigravity.accountCount} Antigravity account${status.antigravity.accountCount === 1 ? "" : "s"}`,
+  })
+  checks.push({
+    code: "gemini_sync",
+    level: status.auth.email && status.antigravity.geminiActiveEmail === status.auth.email ? "ok" : "warn",
+    message: status.antigravity.geminiActiveEmail
+      ? `Gemini active account: ${status.antigravity.geminiActiveEmail}`
+      : "No Gemini active account found",
+  })
+  checks.push({
+    code: "project_id",
+    level: status.auth.projectId
+      ? "ok"
+      : status.antigravity.matchedProjectId
+        ? "warn"
+        : "warn",
+    message: status.auth.projectId
+      ? `auth.json projectId: ${status.auth.projectId}`
+      : status.antigravity.matchedProjectId
+        ? `auth.json missing projectId; Antigravity has ${status.antigravity.matchedProjectId}`
+        : "No projectId available",
+  })
+  checks.push({
+    code: "token_health",
+    level: !status.auth.token.hasCredential
+      ? "fail"
+      : status.auth.token.expired
+        ? status.auth.token.hasRefresh ? "warn" : "fail"
+        : "ok",
+    message: !status.auth.token.hasCredential
+      ? "No Google credential found"
+      : status.auth.token.expires
+        ? `Access token ${status.auth.token.expired ? "expired" : "valid"} ${status.auth.token.relative}`
+        : "Access token expiry unknown",
+  })
+  checks.push({
+    code: "runtime_processes",
+    level: status.runtime.processCount > 0 ? "warn" : "ok",
+    message: `${status.runtime.processCount} running Opencode process${status.runtime.processCount === 1 ? "" : "es"}`,
+  })
+  return checks.concat(status.drift)
+}
